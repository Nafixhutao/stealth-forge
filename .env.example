# PostgreSQL connection (migrations apply automatically on API start)
DATABASE_URL=postgres://stealth:postgres@127.0.0.1:5432/stealth?sslmode=disable
# Bounded PostgreSQL pool settings
DATABASE_MAX_CONNS=16
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
# Redis for rate limiting and worker queues
REDIS_URL=redis://127.0.0.1:6379/0
# 32-byte key, Base64 encoded (openssl rand -base64 32)
FUNCTIONS_SECRET_KEY=
# Dedicated 32-byte App environment encryption key. Never reuse another key.
APPS_SECRET_KEY=
# Stealth-owned Docker runtime image cache budget; persisted OCI artifacts are separate.
APPS_RUNTIME_IMAGE_CACHE_MAX_BYTES=20GiB
APPS_RUNTIME_IMAGE_CACHE_TARGET_BYTES=16GiB
APPS_RUNTIME_IMAGE_GC_INTERVAL=15m
# Dedicated 32-byte bootstrap key; never reuse FUNCTIONS_SECRET_KEY.
BOOTSTRAP_CLI_KEY=
# GitHub App Client ID with Device Flow enabled for first-owner setup.
GITHUB_APP_CLIENT_ID=
# Per-project, per-actor protection for uploads, executions, queued runs,
# backups, and message sends. This is a safety limit, not a billing tier.
PROJECT_OPERATION_RATE_LIMIT=120
PROJECT_OPERATION_RATE_WINDOW=1m
# Optional comma-separated proxy IPs/CIDRs. Forwarded client-IP headers are
# ignored unless the direct peer matches; empty means trust nobody.
TRUSTED_PROXY_CIDRS=
HTTP_ADDR=:8080
# Leave empty to disable the metrics endpoint. If enabled, keep it on a
# private network and require this token in X-Metrics-Token.
METRICS_TOKEN=
PUBLIC_APP_URL=http://localhost:3000
# CONSOLE_CORS_ORIGINS=https://console.example.com
# Optional external sign-in providers. The callback URL to register with the
# provider is http://localhost:8080/v1/oauth/<github|google>/callback.
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# --- Agent runtime (Rust) ---
# Opt-in. Provider execution stays queue-only until this is enabled and the
# worker image contains /usr/local/bin/stealth-agent.
AGENT_RUNNER_ENABLED=false
AGENT_RUNNER_EXECUTION_TIMEOUT=15m
AGENT_RUNTIME_BINARY=/usr/local/bin/stealth-agent
# Non-secret provider metadata shown to the Console.
AGENT_PROVIDER_CATALOG=[{"id":"rinsdev","name":"RinsDev Cloud","models":["deepseek-v4.1-flash-1017"]}]
AGENT_LLM_BASE_URL=https://api.rinsdev.cloud/v1
AGENT_LLM_MODEL=deepseek-v4.1-flash-1017
# Never commit this. Set it in the host environment or config.env.
AGENT_LLM_API_KEY=
AGENT_MAX_STEPS=20
AGENT_MAX_TOKENS=4096
AGENT_TEMPERATURE=0.2
AGENT_REQUEST_TIMEOUT_SECS=120
AGENT_MAX_OUTPUT_BYTES=65536
# Sandbox: no network, read-only rootfs, one shared staging volume.
AGENT_SANDBOX_ENABLED=true
AGENT_SANDBOX_IMAGE=stealth-agent-sandbox:latest
AGENT_SANDBOX_MEMORY=512m
AGENT_SANDBOX_CPUS=1
AGENT_SANDBOX_PIDS=128
AGENT_SANDBOX_TIMEOUT_SECS=120
AGENT_WORK_ROOT=/var/lib/stealth/runner-staging
AGENT_SANDBOX_VOLUME=stealth_function_runner_staging
AGENT_SANDBOX_VOLUME_WORKDIR=/workspace
